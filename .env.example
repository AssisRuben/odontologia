NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL base da Evolution API (WhatsApp)
EVOLUTION_API_URL=
# Chave global (admin) da Evolution API, usada para criar instâncias
EVOLUTION_API_KEY=
# Segredo que o pg_cron envia no header Authorization para /api/cron/messages
CRON_SECRET=
# Token que a Evolution API envia ao chamar /api/webhooks/...
EVOLUTION_WEBHOOK_TOKEN=
# URL pública do app (a Evolution API usa para chamar o webhook)
APP_URL=
