# Copie para /opt/backup/backup.env na VPS e proteja: chmod 600 /opt/backup/backup.env
# Nunca coloque este arquivo preenchido no Git.
# O arquivo é lido como dados: uma configuração por linha, CHAVE=valor, sem espaços ao redor do "=".

# Conexão do banco de PRODUÇÃO (sistemadental-prod), pelo "Session pooler":
# Supabase > botão Connect > Session pooler. Troque [YOUR-PASSWORD] pela senha do banco.
# Se a senha tiver caracteres especiais (@ : / ? # %), use a versão codificada (ex.: @ vira %40).
DB_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Certificado do projeto de produção:
# Supabase > Project Settings > Database > SSL Configuration > Download certificate.
# A conexão é recusada se o servidor não for validado por este certificado.
DB_CA=/opt/backup/supabase-ca.crt

# Versão do pg_dump: precisa ser igual ou maior que a do banco
# (Supabase > Project Settings > Infrastructure > Postgres version).
PG_IMAGE=postgres:17-alpine

# Quantos dias manter as cópias do banco.
# Na VPS o dump NÃO é criptografado, por isso a retenção local é curta.
RETENCAO_LOCAL_DIAS=3
RETENCAO_DRIVE_DIAS=60

# (Opcional) URL de ping do healthchecks.io: avisa por e-mail se o backup não rodar
# HEALTHCHECK_URL=https://hc-ping.com/SEU-UUID
