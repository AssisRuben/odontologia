# Copie para .env.evolution (ignorado pelo git) e preencha.
# Usado por docker-compose.evolution.yml (--env-file e env_file do container).

# Servidor
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

# Chave global da API (mesmo valor de EVOLUTION_API_KEY no .env.local do app). Gere uma aleatória longa.
AUTHENTICATION_API_KEY=troque-por-uma-chave-aleatoria-longa

# Postgres (serviço evolution-postgres)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=evolution
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
# Mantenha usuário/senha/banco iguais aos de POSTGRES_* acima.
DATABASE_CONNECTION_URI=postgresql://evolution:troque-esta-senha@evolution-postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false

# Redis (serviço evolution-redis)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Webhook global desativado: o app registra o webhook por instância ao conectar.
WEBHOOK_GLOBAL_ENABLED=false

# Sessão do WhatsApp
CONFIG_SESSION_PHONE_CLIENT=Odontologia
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# Porta da Evolution no seu computador (padrão 8080). Mude se a 8080 estiver ocupada
# e ajuste EVOLUTION_API_URL no .env.local para a mesma porta.
# EVOLUTION_PORT=8081
